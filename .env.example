# ============================================================
# MEASURA — Variables d'environnement
# Copiez ce fichier vers .env.local (dev) ou ajoutez dans Railway (prod)
# NE JAMAIS committer de vraies clés dans ce fichier (valeurs ci-dessous = placeholders)
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=VOTRE_CLE_ANON

# Clé service role — SERVEUR SEULEMENT, jamais dans le frontend
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=VOTRE_CLE_SERVICE_ROLE

# ── URL de l'application ──────────────────────────────────────
# Développement : http://localhost:3000
# Railway (prod) : https://measura-production.up.railway.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (emails d'invitation) ──────────────────────────────
# Créez un compte sur https://resend.com → API Keys
# Sans cette clé, les invitations créent le lien mais n'envoient pas d'email
RESEND_API_KEY=VOTRE_CLE_RESEND
# Adresse expéditeur (domaine vérifié dans Resend)
RESEND_FROM_EMAIL=noreply@votre-domaine.com

# ── Stripe (paiements & dépôts de soumission) ────────────────
# https://dashboard.stripe.com → Developers → API keys
# Sans ces clés, la facturation fonctionne mais le paiement en ligne est désactivé.
STRIPE_SECRET_KEY=VOTRE_CLE_SECRETE_STRIPE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=VOTRE_CLE_PUBLIABLE_STRIPE
# Stripe Dashboard → Developers → Webhooks → signing secret
# Endpoint à configurer : {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=VOTRE_SECRET_WEBHOOK_STRIPE

# ── QuickBooks Online (synchro comptable — optionnel) ────────
# https://developer.intuit.com → créez une app → Keys & OAuth
# Sans ces clés, l'export CSV fonctionne mais la connexion OAuth est désactivée.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# ── Photogrammétrie dense (optionnel) ────────────────────────
# Service externe SfM/NeRF/Gaussian Splatting (COLMAP cloud, Luma, etc.)
# Sans ces clés, la reconstruction paramétrique (depuis les mesures) fonctionne quand même.
PHOTOGRAMMETRY_API_URL=
PHOTOGRAMMETRY_API_KEY=

# ── Twilio (SMS automatisés) ─────────────────────────────────
# https://console.twilio.com → Account SID + Auth Token + numéro
# Sans ces clés, les automatisations courriel fonctionnent mais pas les SMS.
TWILIO_ACCOUNT_SID=VOTRE_ACCOUNT_SID_TWILIO
TWILIO_AUTH_TOKEN=VOTRE_AUTH_TOKEN_TWILIO
TWILIO_FROM_NUMBER=+15145550123

# ── IA de suivi (Anthropic / Claude) ─────────────────────────
# https://console.anthropic.com → API Keys
# Sans cette clé, le suivi IA bascule sur des suggestions heuristiques.
ANTHROPIC_API_KEY=VOTRE_CLE_ANTHROPIC
# Modèle (optionnel) — défaut : claude-opus-4-8. Pour réduire les coûts : claude-haiku-4-5
ANTHROPIC_MODEL=claude-opus-4-8

# ── Cron (traitement des relances planifiées) ────────────────
# Secret partagé pour protéger /api/cron/process-automations
# Déclencher : Railway Cron ou scheduler externe avec en-tête Authorization: Bearer $CRON_SECRET
CRON_SECRET=changez-moi-pour-une-longue-chaine-aleatoire

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ============================================================
# MEASURA — Variables d'environnement
# Copiez ce fichier vers .env.local (dev) ou ajoutez dans Railway (prod)
# NE JAMAIS committer de vraies clés dans ce fichier
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Clé service role — SERVEUR SEULEMENT, jamais dans le frontend
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── URL de l'application ──────────────────────────────────────
# Développement : http://localhost:3000
# Railway (prod) : https://measura-production.up.railway.app
# Domaine custom : https://votre-domaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (emails d'invitation) ──────────────────────────────
# Créez un compte sur https://resend.com → API Keys
# Sans cette clé, les invitations créent le lien mais n'envoient pas d'email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditeur (domaine vérifié dans Resend)
# Test : onboarding@resend.dev — Production : noreply@votre-domaine.com
RESEND_FROM_EMAIL=noreply@votre-domaine.com

# ── Node ─────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

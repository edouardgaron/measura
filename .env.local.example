# ============================================================
# MEASURA — Variables d'environnement
# Copiez ce fichier vers .env.local et remplissez vos valeurs
# NE JAMAIS committer .env.local dans git
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
# Trouvez ces valeurs : Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key — côté SERVEUR uniquement, jamais dans le frontend
# Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── URL de l'application ──────────────────────────────────────
# Développement : http://localhost:3000
# Production    : https://votre-domaine.com  (sans slash final)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Resend (emails d'invitation client) ───────────────────────
# Créez un compte sur https://resend.com → API Keys
# Sans cette clé les invitations créent le lien mais n'envoient pas d'email
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse expéditeur (domaine vérifié dans Resend)
# En test, utilisez : onboarding@resend.dev
RESEND_FROM_EMAIL=noreply@votre-domaine.com
